CREATE TABLE RECOMMENDATION (ID VARCHAR(255) NOT NULL, CREATEDAT TIMESTAMP, ENTITYSTATE VARCHAR(255), UPDATEDAT TIMESTAMP, USEDFORVOUCHER BOOLEAN, VERSION BIGINT, RECOMMENDED_ID VARCHAR(255), RECOMMENDER_ID VARCHAR(255), PRIMARY KEY (ID))
CREATE TABLE SUBSTITUTION (ID VARCHAR(255) NOT NULL, CREATEDAT TIMESTAMP, ENTITYSTATE VARCHAR(255), QUANTITY INTEGER, UPDATEDAT TIMESTAMP, VERSION BIGINT, price NUMERIC(19,2), INTERVENTION_ID VARCHAR(255), SPAREPART_ID VARCHAR(255), PRIMARY KEY (ID))
CREATE TABLE CLIENT (ID VARCHAR(255) NOT NULL, CREATEDAT TIMESTAMP, ENTITYSTATE VARCHAR(255), UPDATEDAT TIMESTAMP, VERSION BIGINT, CITY VARCHAR(255), COUNTRY VARCHAR(255), POSTALCODE VARCHAR(255), STREET VARCHAR(255), EMAIL VARCHAR(255), NAME VARCHAR(255), SURNAME VARCHAR(255), NIF VARCHAR(255), PHONE VARCHAR(255), PRIMARY KEY (ID))
CREATE TABLE INVOICE (ID VARCHAR(255) NOT NULL, CREATEDAT TIMESTAMP, DATE DATE, ENTITYSTATE VARCHAR(255), NUMBER BIGINT, STATE INTEGER, UPDATEDAT TIMESTAMP, USEDFORVOUCHER BOOLEAN, VERSION BIGINT, subtotal NUMERIC(19,2), total NUMERIC(19,2), vatAmount NUMERIC(19,2), vatRate NUMERIC(19,2), PRIMARY KEY (ID))
CREATE TABLE VEHICLETYPE (ID VARCHAR(255) NOT NULL, CREATEDAT TIMESTAMP, ENTITYSTATE VARCHAR(255), NAME VARCHAR(255), UPDATEDAT TIMESTAMP, VERSION BIGINT, pricePerHour NUMERIC(19,2), PRIMARY KEY (ID))
CREATE TABLE PAYMENTMEAN (ID VARCHAR(255) NOT NULL, DTYPE VARCHAR(31), CREATEDAT TIMESTAMP, ENTITYSTATE VARCHAR(255), UPDATEDAT TIMESTAMP, VERSION BIGINT, accumulated NUMERIC(19,2), CLIENT_ID VARCHAR(255), PRIMARY KEY (ID))
CREATE TABLE CASH (ID VARCHAR(255) NOT NULL, PRIMARY KEY (ID))
CREATE TABLE WORKORDER (ID VARCHAR(255) NOT NULL, CREATEDAT TIMESTAMP, DATE TIMESTAMP, DESCRIPTION VARCHAR(255), ENTITYSTATE VARCHAR(255), STATE INTEGER, UPDATEDAT TIMESTAMP, USEDFORVOUCHER BOOLEAN, VERSION BIGINT, AMOUNT NUMERIC(19,2), INVOICE_ID VARCHAR(255), MECHANIC_ID VARCHAR(255), VEHICLE_ID VARCHAR(255), PRIMARY KEY (ID))
CREATE TABLE CHARGE (ID VARCHAR(255) NOT NULL, CREATEDAT TIMESTAMP, ENTITYSTATE VARCHAR(255), UPDATEDAT TIMESTAMP, VERSION BIGINT, AMOUNT NUMERIC(19,2), INVOICE_ID VARCHAR(255), PAYMENTMEAN_ID VARCHAR(255), PRIMARY KEY (ID))
CREATE TABLE INTERVENTION (ID VARCHAR(255) NOT NULL, CREATEDAT TIMESTAMP, DATE TIMESTAMP, ENTITYSTATE VARCHAR(255), MINUTES INTEGER, UPDATEDAT TIMESTAMP, VERSION BIGINT, MECHANIC_ID VARCHAR(255), WORKORDER_ID VARCHAR(255), PRIMARY KEY (ID))
CREATE TABLE CREDITCARD (ID VARCHAR(255) NOT NULL, TYPE VARCHAR(255), VALIDTHRU DATE, NUMBER VARCHAR(255), PRIMARY KEY (ID))
CREATE TABLE SPAREPART (ID VARCHAR(255) NOT NULL, CODE VARCHAR(255), CREATEDAT TIMESTAMP, DESCRIPTION VARCHAR(255), ENTITYSTATE VARCHAR(255), UPDATEDAT TIMESTAMP, VERSION BIGINT, unitPrice NUMERIC(19,2), PRIMARY KEY (ID))
CREATE TABLE VEHICLE (ID VARCHAR(255) NOT NULL, CREATEDAT TIMESTAMP, ENTITYSTATE VARCHAR(255), MAKE VARCHAR(255), MODEL VARCHAR(255), UPDATEDAT TIMESTAMP, VERSION BIGINT, LICENSEPLATE VARCHAR(255), CLIENT_ID VARCHAR(255), VEHICLETYPE_ID VARCHAR(255), PRIMARY KEY (ID))
CREATE TABLE MECHANIC (ID VARCHAR(255) NOT NULL, CREATEDAT TIMESTAMP, ENTITYSTATE VARCHAR(255), UPDATEDAT TIMESTAMP, VERSION BIGINT, NAME VARCHAR(255), SURNAME VARCHAR(255), NIF VARCHAR(255), PRIMARY KEY (ID))
CREATE TABLE VOUCHER (ID VARCHAR(255) NOT NULL, DESCRIPTION VARCHAR(255), available NUMERIC(19,2), CODE VARCHAR(255), PRIMARY KEY (ID))
