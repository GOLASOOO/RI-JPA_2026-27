ALTER TABLE PUBLIC.WORKORDER ADD CONSTRAINT FK_WORKORDER_MECHANIC_ID FOREIGN KEY(MECHANIC_ID) REFERENCES PUBLIC.MECHANIC(ID)
ALTER TABLE PUBLIC.INTERVENTION ADD CONSTRAINT FK_INTERVENTION_MECHANIC_ID FOREIGN KEY(MECHANIC_ID) REFERENCES PUBLIC.MECHANIC(ID)
