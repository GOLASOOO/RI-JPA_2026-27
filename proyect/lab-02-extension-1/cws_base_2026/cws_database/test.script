CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC.SUBSTITUTION(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),QUANTITY INTEGER,UPDATEDAT TIMESTAMP,VERSION BIGINT,PRICE NUMERIC(19,2),INTERVENTION_ID VARCHAR(255),SPAREPART_ID VARCHAR(255),CONSTRAINT UNQ_SUBSTITUTION_0 UNIQUE(SPAREPART_ID,INTERVENTION_ID))
CREATE MEMORY TABLE PUBLIC.CLIENT(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,CITY VARCHAR(255),COUNTRY VARCHAR(255),POSTALCODE VARCHAR(255),STREET VARCHAR(255),EMAIL VARCHAR(255),NAME VARCHAR(255),SURNAME VARCHAR(255),NIF VARCHAR(255),PHONE VARCHAR(255),CONSTRAINT UNQ_CLIENT_12 UNIQUE(NIF))
CREATE MEMORY TABLE PUBLIC.INVOICE(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,DATE DATE,ENTITYSTATE VARCHAR(255),NUMBER BIGINT,STATE INTEGER,UPDATEDAT TIMESTAMP,VERSION BIGINT,SUBTOTAL NUMERIC(19,2),TOTAL NUMERIC(19,2),VATAMOUNT NUMERIC(19,2),VATRATE NUMERIC(19,2),CONSTRAINT UNQ_INVOICE_4 UNIQUE(NUMBER))
CREATE MEMORY TABLE PUBLIC.VEHICLETYPE(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),NAME VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,PRICEPERHOUR NUMERIC(19,2),CONSTRAINT UNQ_VEHICLETYPE_3 UNIQUE(NAME))
CREATE MEMORY TABLE PUBLIC.PAYMENTMEAN(ID VARCHAR(255) NOT NULL PRIMARY KEY,DTYPE VARCHAR(31),CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,ACCUMULATED NUMERIC(19,2),CLIENT_ID VARCHAR(255),CONSTRAINT FK_PAYMENTMEAN_CLIENT_ID FOREIGN KEY(CLIENT_ID) REFERENCES PUBLIC.CLIENT(ID))
CREATE MEMORY TABLE PUBLIC.CASH(ID VARCHAR(255) NOT NULL PRIMARY KEY,CONSTRAINT FK_CASH_ID FOREIGN KEY(ID) REFERENCES PUBLIC.PAYMENTMEAN(ID))
CREATE MEMORY TABLE PUBLIC.WORKORDER(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,DATE TIMESTAMP,DESCRIPTION VARCHAR(255),ENTITYSTATE VARCHAR(255),STATE INTEGER,UPDATEDAT TIMESTAMP,VERSION BIGINT,AMOUNT NUMERIC(19,2),INVOICE_ID VARCHAR(255),MECHANIC_ID VARCHAR(255),VEHICLE_ID VARCHAR(255),CONSTRAINT UNQ_WORKORDER_0 UNIQUE(VEHICLE_ID,DATE),CONSTRAINT FK_WORKORDER_INVOICE_ID FOREIGN KEY(INVOICE_ID) REFERENCES PUBLIC.INVOICE(ID))
CREATE MEMORY TABLE PUBLIC.CHARGE(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,AMOUNT NUMERIC(19,2),INVOICE_ID VARCHAR(255),PAYMENTMEAN_ID VARCHAR(255),CONSTRAINT UNQ_CHARGE_0 UNIQUE(INVOICE_ID,PAYMENTMEAN_ID),CONSTRAINT FK_CHARGE_PAYMENTMEAN_ID FOREIGN KEY(PAYMENTMEAN_ID) REFERENCES PUBLIC.PAYMENTMEAN(ID),CONSTRAINT FK_CHARGE_INVOICE_ID FOREIGN KEY(INVOICE_ID) REFERENCES PUBLIC.INVOICE(ID))
CREATE MEMORY TABLE PUBLIC.INTERVENTION(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,DATE TIMESTAMP,ENTITYSTATE VARCHAR(255),MINUTES INTEGER,UPDATEDAT TIMESTAMP,VERSION BIGINT,MECHANIC_ID VARCHAR(255),WORKORDER_ID VARCHAR(255),CONSTRAINT UNQ_INTERVENTION_0 UNIQUE(WORKORDER_ID,MECHANIC_ID,DATE),CONSTRAINT FK_INTERVENTION_WORKORDER_ID FOREIGN KEY(WORKORDER_ID) REFERENCES PUBLIC.WORKORDER(ID))
CREATE MEMORY TABLE PUBLIC.CREDITCARD(ID VARCHAR(255) NOT NULL PRIMARY KEY,TYPE VARCHAR(255),VALIDTHRU DATE,NUMBER VARCHAR(255),CONSTRAINT UNQ_CREDITCARD_3 UNIQUE(NUMBER),CONSTRAINT FK_CREDITCARD_ID FOREIGN KEY(ID) REFERENCES PUBLIC.PAYMENTMEAN(ID))
CREATE MEMORY TABLE PUBLIC.SPAREPART(ID VARCHAR(255) NOT NULL PRIMARY KEY,CODE VARCHAR(255),CREATEDAT TIMESTAMP,DESCRIPTION VARCHAR(255),ENTITYSTATE VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,UNITPRICE NUMERIC(19,2),CONSTRAINT UNQ_SPAREPART_1 UNIQUE(CODE))
CREATE MEMORY TABLE PUBLIC.VEHICLE(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),MAKE VARCHAR(255),MODEL VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,LICENSEPLATE VARCHAR(255),CLIENT_ID VARCHAR(255),VEHICLETYPE_ID VARCHAR(255),CONSTRAINT UNQ_VEHICLE_7 UNIQUE(LICENSEPLATE),CONSTRAINT FK_VEHICLE_VEHICLETYPE_ID FOREIGN KEY(VEHICLETYPE_ID) REFERENCES PUBLIC.VEHICLETYPE(ID),CONSTRAINT FK_VEHICLE_CLIENT_ID FOREIGN KEY(CLIENT_ID) REFERENCES PUBLIC.CLIENT(ID))
CREATE MEMORY TABLE PUBLIC.MECHANIC(ID VARCHAR(255) NOT NULL PRIMARY KEY,CREATEDAT TIMESTAMP,ENTITYSTATE VARCHAR(255),UPDATEDAT TIMESTAMP,VERSION BIGINT,NAME VARCHAR(255),SURNAME VARCHAR(255),NIF VARCHAR(255),CONSTRAINT UNQ_MECHANIC_7 UNIQUE(NIF))
CREATE MEMORY TABLE PUBLIC.VOUCHER(ID VARCHAR(255) NOT NULL PRIMARY KEY,DESCRIPTION VARCHAR(255),AVAILABLE NUMERIC(19,2),CODE VARCHAR(255),CONSTRAINT UNQ_VOUCHER_3 UNIQUE(CODE),CONSTRAINT FK_VOUCHER_ID FOREIGN KEY(ID) REFERENCES PUBLIC.PAYMENTMEAN(ID))
ALTER TABLE PUBLIC.SUBSTITUTION ADD CONSTRAINT FK_SUBSTITUTION_SPAREPART_ID FOREIGN KEY(SPAREPART_ID) REFERENCES PUBLIC.SPAREPART(ID)
ALTER TABLE PUBLIC.SUBSTITUTION ADD CONSTRAINT FK_SUBSTITUTION_INTERVENTION_ID FOREIGN KEY(INTERVENTION_ID) REFERENCES PUBLIC.INTERVENTION(ID)
